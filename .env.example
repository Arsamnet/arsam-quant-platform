# Safe bootstrap defaults. Copy to .env and keep that file out of Git.
FX_TRADING_MODE=paper
FX_BIND_HOST=127.0.0.1
FX_BIND_PORT=8000
FX_NODE_ID=local-paper-node
FX_ALLOWED_SYMBOLS=["EURUSD","GBPUSD","USDJPY"]
FX_AI_MODE=disabled
FX_AI_REQUIRED=false
FX_OPENAI_API_KEY=
FX_OPENAI_MODEL=
FX_DATABASE_URL=postgresql+psycopg://fx_platform:CHANGE_ME@127.0.0.1:5432/fx_platform
FX_HMAC_SECRET=
FX_LOG_LEVEL=INFO
FX_MAX_VOLUME=0.10
FX_MAX_OPEN_POSITIONS=3
# Bootstrap safety fixtures, not production risk recommendations.
FX_MAX_DAILY_LOSS_FRACTION=0.02
FX_MAX_DAILY_LOSS_ABSOLUTE_CAP=200
FX_MAX_TRADE_RISK_FRACTION=0.01
FX_ECONOMIC_CALENDAR_REQUIRED=false
